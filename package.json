{
  "name": "scrapella",
  "version": "2.5.1",
  "private": true,
  "description": "Scrapella — a private social scrapbook for personal stories, couples, friends and groups.",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "mobile:sync": "npx cap sync"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "web-push": "^3.6.7",
    "@capacitor/camera": "8.2.4",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "html2canvas": "^1.4.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2"
  }
}
