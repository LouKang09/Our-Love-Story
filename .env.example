# Production: SHA-256 hashes only, never plaintext passwords.
# Format: username:64-char-sha256,username2:64-char-sha256
JOURNAL_USERS_HASHED=you:<sha256-hash>,girlfriend:<sha256-hash>

# Optional local-development plaintext accounts only (ignored in production).
# JOURNAL_USERS=you:change-me,girlfriend:change-me-too

SESSION_SECRET=replace-with-a-long-random-secret
JOURNAL_TITLE=Our Little Book of Us
JOURNAL_SUBTITLE=Every ordinary day deserves to be remembered.
PORT=3000

# For Railway persistence, mount a volume and set this to the mount path.
# Example: /data
# STORAGE_DIR=/data
